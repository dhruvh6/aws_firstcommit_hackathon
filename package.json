{
  "name": "deadstock-exchange",
  "version": "0.1.0",
  "private": true,
  "description": "B2B circular material exchange for industrial surplus - First Commit 2026",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "api",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "dev:web:mock": "npm run dev:mock -w web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "test:contract": "npm run test:contract -w api",
    "seed:local": "tsx scripts/seed-local.mts",
    "seed:dynamo": "tsx scripts/seed-dynamo.mts",
    "seed:demo": "tsx scripts/seed-demo.mts",
    "smoke": "bash scripts/smoke.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}

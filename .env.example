# ─────────────────────────────────────────────────────────────────────────────
#  DeadStock Exchange - example environment file
#  Copy to .env.local (web) / .env (api) and fill in. NEVER commit a real .env.
#  There are no application secrets in this project by design - see
#  docs/05-ARCHITECTURE.md § 7. Anything secret appearing here is a mistake.
# ─────────────────────────────────────────────────────────────────────────────

# ── api (Lambda / local) ────────────────────────────────────────────────────
# memory = in-memory repository seeded from fixtures/ (no AWS needed)
# dynamo = real DynamoDB tables
REPO_DRIVER=memory
TABLE_PREFIX=dse-
PORT=3001
LOG_LEVEL=info
RESERVATION_TTL_MINUTES=2880
ALLOWED_ORIGIN=*
# PHOTO_BUCKET=dse-listing-photos-<account-id>      # P1, set by M3
# AWS_REGION=ap-south-1                             # provided by Lambda at runtime

# ── web (Vite) ──────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3001/v1
# true = MSW intercepts /v1/* and serves fixtures/, so no backend is required
VITE_USE_MOCKS=true
